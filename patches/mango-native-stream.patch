@@ -0,0 +1,190 @@
+/* Exercise the production state machine with protocol/scene doubles; no display. */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <wayland-util.h>
+#include "../src/layout/native_geometry.h"
+
+struct wlr_scene_node { bool enabled; int x, y; };
+struct wlr_scene_tree { struct wlr_scene_node node; };
+struct wlr_surface_state {
+	int width, height, buffer_width, buffer_height, scale, transform;
+};
+struct wlr_surface { bool mapped; struct wlr_surface_state current; };
+struct wlr_xdg_toplevel_state { int min_width, min_height, max_width, max_height; };
+struct wlr_xdg_toplevel { struct wlr_xdg_toplevel_state current; };
+struct xdg_surface {
+	struct wlr_box geometry;
+	struct { uint32_t configure_serial; } current;
+	struct wlr_xdg_toplevel *toplevel;
+};
+typedef struct Client Client;
+typedef struct Monitor {
+	Client *native_reserved, *sel;
+	struct wlr_box w;
+	struct { bool enabled; float scale; char *name; } *wlr_output;
+	uint32_t tagset[2], seltags;
+	bool isoverview;
+} Monitor;
+struct Client {
+	struct wl_list link;
+	Monitor *mon;
+	bool iskilling, x11;
+	uint32_t tags, id, native_serial;
+	int reserve_right, native_width, native_height;
+	enum native_status native_status;
+	enum native_reason native_reason;
+	bool native_ever_accepted, native_close_sent, native_hints_pending, is_pending_open_animation, need_output_flush;
+	struct wlr_box native_geom, native_usable, geom, current, pending;
+	float native_scale;
+	struct { bool running, tagining, tagouting, tagouted; struct wlr_box current; } animation;
+	struct { struct xdg_surface *xdg; } surface;
+	struct wlr_surface wl_surface;
+	struct wlr_scene_tree *scene, *scene_surface, *border, *shadow, *blur, *shield;
+	struct { struct wlr_scene_tree *scene_buffer; } *group_bar;
+	int close_count;
+};
+static struct wl_list clients;
+static struct { struct { struct wlr_surface *focused_surface; } keyboard_state; } seat_storage;
+static typeof(seat_storage) *seat = &seat_storage;
+static uint32_t next_serial = 1;
+static bool wlr_box_equal(const struct wlr_box *a, const struct wlr_box *b) {
+	return a->x == b->x && a->y == b->y && a->width == b->width && a->height == b->height;
+}
+static struct wlr_surface *client_surface(Client *c) { return &c->wl_surface; }
+static bool client_is_x11(Client *c) { return c->x11; }
+static void client_send_close(Client *c) { c->close_count++; }
+static void focusclient(Client *c, int lift) { (void)lift; c->mon->sel = c; }
+static void wlr_seat_keyboard_clear_focus(typeof(seat) s) { s->keyboard_state.focused_surface = NULL; }
+static void wlr_scene_node_set_enabled(struct wlr_scene_node *n, bool e) { n->enabled = e; }
+static void wlr_scene_node_set_position(struct wlr_scene_node *n, int x, int y) { n->x=x; n->y=y; }
+static void wlr_scene_subsurface_tree_set_clip(struct wlr_scene_node *n, void *p) { (void)n; (void)p; }
+static uint32_t wlr_xdg_toplevel_set_size(struct wlr_xdg_toplevel *t, int w, int h) {
+	(void)t; (void)w; (void)h; return next_serial++;
+}
+#include "../src/layout/native_stream.h"
+
+struct fixture {
+	Client c;
+	struct xdg_surface xdg;
+	struct wlr_xdg_toplevel top;
+	struct wlr_scene_tree scene, surface, decor;
+	typeof(*((Client *)0)->group_bar) group;
+};
+static void init(struct fixture *f, Monitor *m, int id, int w, int h) {
+	memset(f, 0, sizeof(*f));
+	f->c = (Client){.mon=m, .id=id, .tags=1, .reserve_right=1,
+		.scene=&f->scene, .scene_surface=&f->surface,
+		.border=&f->decor, .shadow=&f->decor, .blur=&f->decor, .shield=&f->decor,
+		.group_bar=&f->group};
+	f->group.scene_buffer = &f->decor;
+	f->xdg.toplevel = &f->top;
+	f->c.surface.xdg = &f->xdg;
+	f->c.wl_surface.mapped = true;
+	f->top.current = (struct wlr_xdg_toplevel_state){w,h,w,h};
+	wl_list_insert(clients.prev, &f->c.link);
+}
+static void ack(struct fixture *f) {
+	f->xdg.current.configure_serial = f->c.native_serial;
+	f->xdg.geometry = (struct wlr_box){0,0,f->c.native_width,f->c.native_height};
+	f->c.wl_surface.current = (struct wlr_surface_state){
+		f->c.native_width,f->c.native_height,f->c.native_width,f->c.native_height,1,0};
+}
+int main(void) {
+	wl_list_init(&clients);
+	typeof(*((Monitor *)0)->wlr_output) output = {true, 1, "DP-2"};
+	Monitor m = {.w={0,0,3398,1440},.wlr_output=&output,.tagset={1,2}};
+	struct fixture first, second, zero;
+	init(&first, &m, 1, 1920, 1080);
+	native_update_monitor(&m);
+	assert(m.native_reserved == &first.c && first.c.native_status == NATIVE_PENDING);
+	assert(first.c.geom.x == 1478 && first.c.geom.y == 180 && !first.scene.node.enabled);
+	/* Size alone cannot accept an unacknowledged configure. */
+	ack(&first);
+	first.xdg.current.configure_serial--;
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_PENDING);
+	ack(&first);
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_ACCEPTED && first.scene.node.enabled);
+	assert(first.scene.node.x == 1478 && first.scene.node.y == 180);
+	uint32_t serial = first.c.native_serial;
+	native_update_monitor(&m);
+	assert(first.c.native_serial == serial);
+	/* A new stream cannot steal a live reservation. */
+	init(&second, &m, 2, 1280, 720);
+	native_update_monitor(&m);
+	assert(m.native_reserved == &first.c && second.c.native_reason == NATIVE_REGION_OCCUPIED);
+	assert(second.c.native_status == NATIVE_REJECTED && second.c.close_count == 0);
+	/* Away/return releases/reinstalls the column without closing the stream. */
+	m.seltags = 1;
+	native_update_monitor(&m);
+	assert(!m.native_reserved && !first.scene.node.enabled && first.c.close_count == 0);
+	m.seltags = 0;
+	native_update_monitor(&m);
+	assert(m.native_reserved == &first.c && first.c.native_status == NATIVE_ACCEPTED);
+	/* New valid hints configure a new exact size, not a scaled old buffer. */
+	first.top.current.min_width = 1280;
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_PENDING && first.c.close_count == 0);
+	assert(m.native_reserved == &first.c && first.c.native_geom.width == 1920);
+	first.top.current = (struct wlr_xdg_toplevel_state){1280,720,1280,720};
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_PENDING && !first.scene.node.enabled);
+	ack(&first);
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_ACCEPTED && first.c.geom.x == 2118);
+	/* Even after acceptance, a wrong buffer is not shown. */
+	first.c.wl_surface.current.buffer_width--;
+	native_present(&first.c);
+	assert(!first.scene.node.enabled);
+	ack(&first);
+	native_update_monitor(&m);
+	assert(first.scene.node.enabled);
+	/* Revocation preserves JSON state and requests close exactly once. */
+	output.scale = 1.25;
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_REJECTED && first.c.native_reason == NATIVE_UNSUPPORTED_SCALE);
+	assert(!m.native_reserved && first.c.close_count == 1 && !first.scene.node.enabled);
+	native_update_monitor(&m);
+	assert(first.c.close_count == 1);
+	output.scale = 1;
+	init(&zero, &m, 3, 0, 0);
+	native_update_monitor(&m);
+	assert(zero.c.native_status == NATIVE_PENDING && !m.native_reserved);
+	zero.top.current = (struct wlr_xdg_toplevel_state){1920,1080,1920,1080};
+	native_update_monitor(&m);
+	ack(&zero);
+	native_update_monitor(&m);
+	assert(zero.c.native_status == NATIVE_ACCEPTED);
+	output.enabled = false;
+	native_update_monitor(&m);
+	assert(zero.c.native_reason == NATIVE_OUTPUT_UNAVAILABLE && zero.c.close_count == 1);
+	assert(strcmp(native_status_names[zero.c.native_status], "rejected") == 0);
+	assert(strcmp(native_reason_names[zero.c.native_reason], "output_unavailable") == 0);
+	/* A correctly sized initial neutral buffer must not need another commit. */
+	wl_list_init(&clients);
+	output.enabled = true;
+	m.native_reserved = NULL;
+	init(&zero, &m, 4, 1920, 1080);
+	zero.c.native_width = 1920;
+	zero.c.native_height = 1080;
+	ack(&zero);
+	zero.xdg.current.configure_serial = 50;
+	uint32_t before = next_serial;
+	native_update_monitor(&m);
+	assert(zero.c.native_status == NATIVE_ACCEPTED && next_serial == before);
+	/* Unmap releases the reservation, so another stream can be admitted. */
+	zero.c.wl_surface.mapped = false;
+	native_update_monitor(&m);
+	assert(!m.native_reserved && zero.c.close_count == 0);
+	init(&first, &m, 5, 2758, 1440);
+	native_update_monitor(&m);
+	ack(&first);
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_ACCEPTED);
+	m.w.width--;
+	native_update_monitor(&m);
+	assert(first.c.native_reason == NATIVE_TOO_LARGE && first.c.close_count == 1);
+	puts("native reservation: all checks passed");
+}
