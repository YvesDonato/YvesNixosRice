diff --git a/tests/NATIVE_SPLIT.md b/tests/NATIVE_SPLIT.md
new file mode 100644
index 00000000..54a556f8
--- /dev/null
+++ b/tests/NATIVE_SPLIT.md
@@ -0,0 +1,43 @@
+# Native Split Checks
+
+Build normally with Meson, then run `meson test -C build --print-errorlogs`.
+`native_geometry` covers exact placement, the 640-pixel local minimum,
+panel-sized usable bounds, negative origins, overflow, fixed hints, output
+availability, scaling, and conflicting reservations. `native_reservation`
+drives the production state machine with scene/protocol doubles, including
+configure acknowledgement, an already-sized neutral buffer, hint transitions,
+workspace release/return, conflict rejection, buffer mismatches, output
+revocation, and unmap.
+
+## Isolated Integration
+
+Never run these checks on a live desktop. Create a private `XDG_RUNTIME_DIR`,
+unset `DISPLAY` and `WAYLAND_DISPLAY`, use `WLR_BACKENDS=headless` and
+`WLR_HEADLESS_OUTPUTS=1`, and pass Mango a separate configuration. Compile
+`headless-output.c` with `cc -shared -fPIC -ldl` and preload it for that Mango
+process only to name the initial output `DP-2`. Scenefx requires a working
+render node; software-only initialization is not supported by every build.
+
+Use these test rules with zero gaps, border width 2, and animations disabled:
+
+```
+monitorrule=name:DP-2,scale:1,x:0,y:0,width:3398,height:1440,refresh:60
+tagrule=id:1,layout_name:tile
+windowrule=appid:^com\.linuxmis\.linuxmis$,title:^Linuxmis Native Stream$,monitor:DP-2,isfloating:0,isnoborder:1,noswallow:1,reserve_right:1
+```
+
+Set **both** the test client's `WAYLAND_DISPLAY` and `MANGO_INSTANCE_SIGNATURE`
+to the private compositor. `mmsg` uses `MANGO_INSTANCE_SIGNATURE`, not just
+`XDG_RUNTIME_DIR`. Map an SDL client with equal positive min/max size hints,
+present a neutral buffer, and query `get all-clients`. Accept only an explicit
+`reservation.status == "accepted"` before presenting video. A neutral buffer
+already at the requested size does not require another configure/commit.
+
+At 1920x1080, verify `(1478,180)` and two local clients each occupying 739
+pixels on the left. Capture a black/white single-pixel-column test pattern and
+compare all 2073600 stream pixels. Check 1920x1440 and 2758x1440 acceptance,
+2759x1440 and 1920x1441 rejection, blocked resize/floating/fullscreen/group
+actions, second-stream rejection, workspace return, and tile-layout restoration
+after close. Disable the private output with an accepted client paused to
+verify its retained `rejected/output_unavailable` IPC record before it handles
+the close event. Stop only the private compositor and remove its runtime.
diff --git a/tests/headless-output.c b/tests/headless-output.c
new file mode 100644
index 00000000..7363c007
--- /dev/null
+++ b/tests/headless-output.c
@@ -0,0 +1,20 @@
+/* Test-only preload: name the initial, not-yet-advertised headless output DP-2. */
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdlib.h>
+struct wlr_backend;
+struct wlr_output;
+struct wlr_output *wlr_headless_add_output(struct wlr_backend *backend,
+	unsigned width, unsigned height) {
+	struct wlr_output *(*add)(struct wlr_backend *, unsigned, unsigned) =
+		dlsym(RTLD_NEXT, "wlr_headless_add_output");
+	void (*name)(struct wlr_output *, const char *) =
+		dlsym(RTLD_NEXT, "wlr_output_set_name");
+	if (!add || !name)
+		abort();
+	struct wlr_output *output = add(backend, width, height);
+	static int named;
+	if (output && !named++)
+		name(output, "DP-2");
+	return output;
+}
diff --git a/tests/native_geometry.c b/tests/native_geometry.c
new file mode 100644
index 00000000..f17395aa
--- /dev/null
+++ b/tests/native_geometry.c
@@ -0,0 +1,46 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../src/layout/native_geometry.h"
+
+int main(void) {
+	struct wlr_box usable = {0, 0, 3398, 1440}, stream = {0}, local = {0};
+	assert(native_geometry(usable, 1, true, false, 1920, 1440, 1920, 1440,
+		&stream, &local) == NATIVE_OK);
+	assert(stream.x == 1478 && stream.y == 0 && stream.width == 1920 &&
+		stream.height == 1440 && local.width == 1478 && local.height == 1440);
+	assert(native_geometry(usable, 1, true, false, 1920, 1080, 1920, 1080,
+		&stream, &local) == NATIVE_OK);
+	assert(stream.y == 180 && stream.height == 1080);
+	assert(native_geometry(usable, 1, true, false, 2758, 1440, 2758, 1440,
+		&stream, &local) == NATIVE_OK && local.width == 640);
+	assert(native_geometry(usable, 1, true, false, 2759, 1440, 2759, 1440,
+		&stream, &local) == NATIVE_TOO_LARGE);
+	assert(native_geometry(usable, 1, true, false, 1920, 1441, 1920, 1441,
+		&stream, &local) == NATIVE_TOO_LARGE);
+	assert(native_geometry(usable, 1, true, false, INT_MAX, 1440, INT_MAX, 1440,
+		&stream, &local) == NATIVE_TOO_LARGE);
+	assert(native_geometry(usable, 1, true, false, 0, 1440, 0, 1440,
+		&stream, &local) == NATIVE_INVALID_SIZE);
+	assert(native_geometry(usable, 1, true, false, 1920, 1080, 1921, 1080,
+		&stream, &local) == NATIVE_INVALID_SIZE);
+	assert(native_geometry(usable, 1, false, false, 1920, 1080, 1920, 1080,
+		&stream, &local) == NATIVE_OUTPUT_UNAVAILABLE);
+	assert(native_geometry(usable, 1.333333f, true, false, 1920, 1080, 1920, 1080,
+		&stream, &local) == NATIVE_UNSUPPORTED_SCALE);
+	assert(native_geometry(usable, NAN, true, false, 1920, 1080, 1920, 1080,
+		&stream, &local) == NATIVE_UNSUPPORTED_SCALE);
+	assert(native_geometry(usable, 1, true, true, 1920, 1080, 1920, 1080,
+		&stream, &local) == NATIVE_REGION_OCCUPIED);
+	usable = (struct wlr_box){-3440, -20, 3398, 1439};
+	assert(native_geometry(usable, 1, true, false, 1920, 1080, 1920, 1080,
+		&stream, &local) == NATIVE_OK);
+	assert(stream.x == -1962 && stream.y == 159 && local.x == -3440);
+	usable.x = INT_MAX;
+	assert(native_geometry(usable, 1, true, false, 1920, 1080, 1920, 1080,
+		&stream, &local) == NATIVE_INVALID_SIZE);
+	assert(strcmp(native_status_names[NATIVE_PENDING], "pending") == 0);
+	assert(strcmp(native_reason_names[NATIVE_TOO_LARGE], "too_large") == 0);
+	puts("native geometry: all checks passed");
+	return 0;
+}
