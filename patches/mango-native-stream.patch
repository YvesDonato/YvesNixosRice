@@ -0,0 +1,20 @@
+/* Test-only preload: name the initial, not-yet-advertised headless output DP-2. */
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdlib.h>
+struct wlr_backend;
+struct wlr_output;
+struct wlr_output *wlr_headless_add_output(struct wlr_backend *backend,
+	unsigned width, unsigned height) {
+	struct wlr_output *(*add)(struct wlr_backend *, unsigned, unsigned) =
+		dlsym(RTLD_NEXT, "wlr_headless_add_output");
+	void (*name)(struct wlr_output *, const char *) =
+		dlsym(RTLD_NEXT, "wlr_output_set_name");
+	if (!add || !name)
+		abort();
+	struct wlr_output *output = add(backend, width, height);
+	static int named;
+	if (output && !named++)
+		name(output, "DP-2");
+	return output;
+}
diff --git a/tests/native_geometry.c b/tests/native_geometry.c
new file mode 100644
index 00000000..838f0cfe
--- /dev/null
+++ b/tests/native_geometry.c
@@ -0,0 +1,48 @@
+#include "../src/layout/native_geometry.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+int main(void) {
+	struct wlr_box usable = {0, 0, 3398, 1440}, stream = {0}, local = {0};
+	assert(native_geometry(usable, 1, true, false, 1920, 1440, 1920, 1440,
+						   &stream, &local) == NATIVE_OK);
+	assert(stream.x == 1478 && stream.y == 0 && stream.width == 1920 &&
+		   stream.height == 1440 && local.width == 1478 &&
+		   local.height == 1440);
+	assert(native_geometry(usable, 1, true, false, 1920, 1080, 1920, 1080,
+						   &stream, &local) == NATIVE_OK);
+	assert(stream.y == 180 && stream.height == 1080);
+	assert(native_geometry(usable, 1, true, false, 2758, 1440, 2758, 1440,
+						   &stream, &local) == NATIVE_OK &&
+		   local.width == 640);
+	assert(native_geometry(usable, 1, true, false, 2759, 1440, 2759, 1440,
+						   &stream, &local) == NATIVE_TOO_LARGE);
+	assert(native_geometry(usable, 1, true, false, 1920, 1441, 1920, 1441,
+						   &stream, &local) == NATIVE_TOO_LARGE);
+	assert(native_geometry(usable, 1, true, false, INT_MAX, 1440, INT_MAX, 1440,
+						   &stream, &local) == NATIVE_TOO_LARGE);
+	assert(native_geometry(usable, 1, true, false, 0, 1440, 0, 1440, &stream,
+						   &local) == NATIVE_INVALID_SIZE);
+	assert(native_geometry(usable, 1, true, false, 1920, 1080, 1921, 1080,
+						   &stream, &local) == NATIVE_INVALID_SIZE);
+	assert(native_geometry(usable, 1, false, false, 1920, 1080, 1920, 1080,
+						   &stream, &local) == NATIVE_OUTPUT_UNAVAILABLE);
+	assert(native_geometry(usable, 1.333333f, true, false, 1920, 1080, 1920,
+						   1080, &stream, &local) == NATIVE_UNSUPPORTED_SCALE);
+	assert(native_geometry(usable, NAN, true, false, 1920, 1080, 1920, 1080,
+						   &stream, &local) == NATIVE_UNSUPPORTED_SCALE);
+	assert(native_geometry(usable, 1, true, true, 1920, 1080, 1920, 1080,
+						   &stream, &local) == NATIVE_REGION_OCCUPIED);
+	usable = (struct wlr_box){-3440, -20, 3398, 1439};
+	assert(native_geometry(usable, 1, true, false, 1920, 1080, 1920, 1080,
+						   &stream, &local) == NATIVE_OK);
+	assert(stream.x == -1962 && stream.y == 159 && local.x == -3440);
+	usable.x = INT_MAX;
+	assert(native_geometry(usable, 1, true, false, 1920, 1080, 1920, 1080,
+						   &stream, &local) == NATIVE_INVALID_SIZE);
+	assert(strcmp(native_status_names[NATIVE_PENDING], "pending") == 0);
+	assert(strcmp(native_reason_names[NATIVE_TOO_LARGE], "too_large") == 0);
+	puts("native geometry: all checks passed");
+	return 0;
+}
diff --git a/tests/native_prediction.c b/tests/native_prediction.c
new file mode 100644
index 00000000..eb66c1fc
--- /dev/null
+++ b/tests/native_prediction.c
@@ -0,0 +1,98 @@
+/* Run the production scroller cores without a display, scene, or reservation
+ * update. */
+#include "mango/common/server.h"
+#include "mango/layout/layout.h"
+#include "mango/layout/native.h"
+#include "mango/manage/client.h"
+#include "mango/manage/monitor.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+MangoServer server;
+Config config;
+Layout layouts[14] = {[0] = {.id = TILE}, [1] = {.id = SCROLLER}};
+
+bool client_wants_group_bar(Client *c) {
+	(void)c;
+	return false;
+}
+
+uint32_t get_mon_curtag(const Monitor *m) { return m->pertag->curtag; }
+
+void client_tile_resize(Client *c, struct wlr_box box, int32_t interact,
+						const LayoutContext *ctx) {
+	(void)interact;
+	/* The core must never pass the reserved client to either path. */
+	assert(!c->reserve_right);
+	if (ctx && ctx->probe) {
+		if (c == ctx->probe)
+			*ctx->out = box;
+	} else {
+		c->geom = box;
+	}
+}
+
+static void add(Client *c, Monitor *m) {
+	c->mon = m;
+	c->tags = 1;
+	c->scroller_proportion = 0.5f;
+	wl_list_insert(server.clients.prev, &c->link);
+}
+
+int main(void) {
+	Pertag pertag = {.curtag = 1};
+	Monitor m = {.pertag = &pertag, .w = {0, 0, 3398, 1440}, .tagset = {1, 2}};
+	Client stream = {.reserve_right = 1,
+					 .native_status = NATIVE_ACCEPTED,
+					 .native_geom = {1478, 180, 1920, 1080},
+					 .native_serial = 17};
+	Client first = {0}, second = {0};
+	wl_list_init(&server.clients);
+	add(&stream, &m);
+	add(&first, &m);
+	add(&second, &m);
+	m.native_reserved = &stream;
+	pertag.ltidxs[1] = &layouts[0];
+	pertag.scroller_default_proportion[1] = 0.5f;
+	update_scroller_state(&m);
+	Client *stream_client = &stream, *local_client = &first;
+	assert(!ISTILED(stream_client) && !ISFAKETILED(stream_client) &&
+		   !ISSCROLLTILED(stream_client));
+	assert(ISTILED(local_client) && native_layout(&m)->id == SCROLLER);
+	Client saved_stream;
+	memcpy(&saved_stream, &stream, sizeof(stream));
+	struct wlr_box a = {0}, b = {0}, reserved = {0};
+	assert(scroller_predict(&m, &first, &a));
+	assert(scroller_predict(&m, &second, &b));
+	assert(!scroller_predict(&m, &stream, &reserved));
+	assert(a.x == 0 && a.y == 0 && a.width == 739 && a.height == 1440);
+	assert(b.x == 739 && b.width == 739 && b.height == 1440);
+	assert(first.geom.width == 0 && second.geom.width == 0);
+	assert(m.native_reserved == &stream &&
+		   !memcmp(&stream, &saved_stream, sizeof(stream)));
+	scroller(&m);
+	assert(wlr_box_equal(&a, &first.geom) && wlr_box_equal(&b, &second.geom));
+	assert(vertical_scroller_predict(&m, &first, &a));
+	assert(a.width == 1478 && a.height == 720);
+	assert(!vertical_scroller_predict(&m, &stream, &reserved));
+	assert(m.native_reserved == &stream &&
+		   !memcmp(&stream, &saved_stream, sizeof(stream)));
+	/* Fullscreen pages use the panel-adjusted origin in both core branches. */
+	m.w.x = 100;
+	m.w.y = 50;
+	m.m = (struct wlr_box){0, 0, 3498, 1490};
+	m.sel = &first;
+	first.isfullscreen = 1;
+	pertag.scroller_default_proportion[1] = 0.75f;
+	assert(scroller_predict(&m, &first, &a));
+	assert(a.x == 100 && a.y == 50 && a.width == 1478 && a.height == 1440);
+	assert(vertical_scroller_predict(&m, &first, &a));
+	assert(a.x == 100 && a.y == 50 && a.width == 1478 && a.height == 1440);
+	/* Release restores both the saved layout and the full workarea. */
+	m.native_reserved = NULL;
+	assert(native_layout(&m)->id == TILE && native_workarea(&m).width == 3398);
+	cleanup_monitor_scroller(&m);
+	puts("native prediction: all checks passed");
+	return 0;
+}
diff --git a/tests/native_reservation.c b/tests/native_reservation.c
new file mode 100644
index 00000000..91fcce45
--- /dev/null
+++ b/tests/native_reservation.c
@@ -0,0 +1,357 @@
+/* Exercise the production state machine with protocol/scene doubles; no
+ * display. */
+#include "../src/layout/native_geometry.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include <wayland-util.h>
+
+struct wlr_scene_node {
+	bool enabled;
+	int x, y;
+};
+struct wlr_scene_tree {
+	struct wlr_scene_node node;
+};
+struct wlr_surface_state {
+	int width, height, buffer_width, buffer_height, scale, transform;
+};
+struct wlr_surface {
+	bool mapped;
+	struct wlr_surface_state current;
+};
+struct wlr_xdg_toplevel_state {
+	int min_width, min_height, max_width, max_height;
+};
+struct wlr_xdg_toplevel {
+	struct wlr_xdg_toplevel_state current;
+};
+struct xdg_surface {
+	struct wlr_box geometry;
+	struct {
+		uint32_t configure_serial;
+	} current;
+	struct wlr_xdg_toplevel *toplevel;
+};
+typedef struct Client Client;
+typedef struct Monitor {
+	Client *native_reserved, *sel;
+	struct wlr_box w;
+	struct {
+		bool enabled;
+		float scale;
+		char *name;
+	} *wlr_output;
+	uint32_t tagset[2], seltags;
+	bool isoverview, only_sleep;
+} Monitor;
+struct Client {
+	struct wl_list link;
+	Monitor *mon;
+	bool iskilling, x11;
+	uint32_t tags, id, native_serial;
+	int reserve_right, native_width, native_height;
+	enum native_status native_status;
+	enum native_reason native_reason;
+	bool native_ever_accepted, native_close_sent, native_hints_pending,
+		is_pending_open_animation, need_output_flush;
+	struct wlr_box native_geom, native_usable, geom, current, pending;
+	float native_scale;
+	struct {
+		bool running, tagining, tagouting, tagouted;
+		struct wlr_box current;
+	} animation;
+	struct {
+		struct xdg_surface *xdg;
+	} surface;
+	struct wlr_surface wl_surface;
+	struct wlr_scene_tree *scene, *scene_surface, *border, *shadow, *blur,
+		*shield;
+	struct {
+		struct wlr_scene_tree *scene_buffer, *scene;
+	} *group_bar, *dim_node;
+	int close_count;
+};
+
+static struct {
+	struct {
+		struct wlr_surface *focused_surface;
+	} keyboard_state;
+} seat_storage;
+static struct {
+	struct wl_list clients;
+	typeof(seat_storage) *seat;
+} server = {.seat = &seat_storage};
+static uint32_t next_serial = 1;
+static bool wlr_box_equal(const struct wlr_box *a, const struct wlr_box *b) {
+	return a->x == b->x && a->y == b->y && a->width == b->width &&
+		   a->height == b->height;
+}
+static struct wlr_surface *client_surface(Client *c) { return &c->wl_surface; }
+static bool client_is_x11(Client *c) { return c->x11; }
+static void client_send_close(Client *c) { c->close_count++; }
+static void client_focus(Client *c, int lift) {
+	(void)lift;
+	c->mon->sel = c;
+}
+static void wlr_seat_keyboard_clear_focus(typeof(server.seat) s) {
+	s->keyboard_state.focused_surface = NULL;
+}
+static void wlr_scene_node_set_enabled(struct wlr_scene_node *n, bool e) {
+	n->enabled = e;
+}
+static void wlr_scene_node_set_position(struct wlr_scene_node *n, int x,
+										int y) {
+	n->x = x;
+	n->y = y;
+}
+static void wlr_scene_subsurface_tree_set_clip(struct wlr_scene_node *n,
+											   void *p) {
+	(void)n;
+	(void)p;
+}
+static uint32_t wlr_xdg_toplevel_set_size(struct wlr_xdg_toplevel *t, int w,
+										  int h) {
+	(void)t;
+	(void)w;
+	(void)h;
+	return next_serial++;
+}
+#include "../src/layout/native_stream.h"
+
+struct fixture {
+	Client c;
+	struct xdg_surface xdg;
+	struct wlr_xdg_toplevel top;
+	struct wlr_scene_tree scene, surface, decor;
+	typeof(*((Client *)0)->group_bar) group;
+};
+static void init(struct fixture *f, Monitor *m, int id, int w, int h) {
+	memset(f, 0, sizeof(*f));
+	f->c = (Client){.mon = m,
+					.id = id,
+					.tags = 1,
+					.reserve_right = 1,
+					.scene = &f->scene,
+					.scene_surface = &f->surface,
+					.border = &f->decor,
+					.shadow = &f->decor,
+					.blur = &f->decor,
+					.shield = &f->decor,
+					.group_bar = &f->group};
+	f->group.scene_buffer = f->group.scene = &f->decor;
+	f->xdg.toplevel = &f->top;
+	f->c.surface.xdg = &f->xdg;
+	f->c.wl_surface.mapped = true;
+	f->top.current = (struct wlr_xdg_toplevel_state){w, h, w, h};
+	wl_list_insert(server.clients.prev, &f->c.link);
+}
+static void ack(struct fixture *f) {
+	f->xdg.current.configure_serial = f->c.native_serial;
+	f->xdg.geometry =
+		(struct wlr_box){0, 0, f->c.native_width, f->c.native_height};
+	f->c.wl_surface.current = (struct wlr_surface_state){f->c.native_width,
+														 f->c.native_height,
+														 f->c.native_width,
+														 f->c.native_height,
+														 1,
+														 0};
+}
+static void test_overview_and_sleep(void) {
+	wl_list_init(&server.clients);
+	typeof(*((Monitor *)0)->wlr_output) output = {true, 1, "DP-2"};
+	Monitor m = {
+		.w = {0, 0, 3398, 1440}, .wlr_output = &output, .tagset = {1, 2}};
+	struct fixture accepted, newcomer;
+	init(&accepted, &m, 10, 1920, 1080);
+	native_update_monitor(&m);
+	ack(&accepted);
+	native_update_monitor(&m);
+	assert(accepted.c.native_status == NATIVE_ACCEPTED);
+
+	/* A backgrounded stream survives entering overview on another tag. */
+	m.seltags = 1;
+	native_update_monitor(&m);
+	m.isoverview = true;
+	native_update_monitor(&m);
+	assert(accepted.c.native_status == NATIVE_PENDING &&
+		   accepted.c.native_reason == NATIVE_OK &&
+		   accepted.c.close_count == 0);
+	assert(!m.native_reserved && !accepted.scene.node.enabled);
+
+	/* A stream mapping during overview can be admitted after overview exits. */
+	init(&newcomer, &m, 11, 1280, 720);
+	newcomer.c.tags = 2;
+	native_update_monitor(&m);
+	assert(newcomer.c.native_status == NATIVE_PENDING &&
+		   newcomer.c.native_reason == NATIVE_OK &&
+		   newcomer.c.close_count == 0);
+	assert(!newcomer.scene.node.enabled && !m.native_reserved);
+	m.isoverview = false;
+	native_update_monitor(&m);
+	ack(&newcomer);
+	native_update_monitor(&m);
+	assert(newcomer.c.native_status == NATIVE_ACCEPTED &&
+		   newcomer.scene.node.enabled && m.native_reserved == &newcomer.c);
+	assert(accepted.c.close_count == 0);
+
+	/* Overview also hides a visible accepted owner without revoking it. */
+	m.isoverview = true;
+	native_update_monitor(&m);
+	assert(newcomer.c.native_status == NATIVE_PENDING &&
+		   !newcomer.scene.node.enabled && newcomer.c.close_count == 0);
+	m.isoverview = false;
+	native_update_monitor(&m);
+	assert(newcomer.c.native_status == NATIVE_ACCEPTED &&
+		   newcomer.scene.node.enabled);
+
+	/* DPMS suspension retains ownership and admission history, then resumes. */
+	uint32_t serial = newcomer.c.native_serial;
+	m.only_sleep = true;
+	output.enabled = false;
+	native_update_monitor(&m);
+	assert(newcomer.c.native_status == NATIVE_PENDING &&
+		   newcomer.c.native_reason == NATIVE_OK &&
+		   !newcomer.scene.node.enabled);
+	assert(m.native_reserved == &newcomer.c && newcomer.c.close_count == 0);
+	native_update_monitor(&m);
+	assert(newcomer.c.native_serial == serial && newcomer.c.close_count == 0);
+	output.enabled = true;
+	m.only_sleep = false;
+	native_update_monitor(&m);
+	assert(newcomer.c.native_status == NATIVE_ACCEPTED &&
+		   newcomer.scene.node.enabled && newcomer.c.native_serial == serial);
+	assert(m.native_reserved == &newcomer.c && newcomer.c.close_count == 0);
+
+	/* Actual disable remains a permanent rejection, even after later sleep. */
+	output.enabled = false;
+	native_update_monitor(&m);
+	assert(newcomer.c.native_status == NATIVE_REJECTED &&
+		   newcomer.c.native_reason == NATIVE_OUTPUT_UNAVAILABLE &&
+		   newcomer.c.close_count == 1 && !m.native_reserved);
+	m.only_sleep = true;
+	native_update_monitor(&m);
+	assert(newcomer.c.native_status == NATIVE_REJECTED &&
+		   newcomer.c.close_count == 1);
+}
+
+int main(void) {
+	wl_list_init(&server.clients);
+	typeof(*((Monitor *)0)->wlr_output) output = {true, 1, "DP-2"};
+	Monitor m = {
+		.w = {0, 0, 3398, 1440}, .wlr_output = &output, .tagset = {1, 2}};
+	struct fixture first, second, zero;
+	init(&first, &m, 1, 1920, 1080);
+	native_update_monitor(&m);
+	assert(m.native_reserved == &first.c &&
+		   first.c.native_status == NATIVE_PENDING);
+	assert(first.c.geom.x == 1478 && first.c.geom.y == 180 &&
+		   !first.scene.node.enabled);
+	/* Size alone cannot accept an unacknowledged configure. */
+	ack(&first);
+	first.xdg.current.configure_serial--;
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_PENDING);
+	ack(&first);
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_ACCEPTED &&
+		   first.scene.node.enabled);
+	assert(first.scene.node.x == 1478 && first.scene.node.y == 180);
+	uint32_t serial = first.c.native_serial;
+	native_update_monitor(&m);
+	assert(first.c.native_serial == serial);
+	/* A new stream cannot steal a live reservation. */
+	init(&second, &m, 2, 1280, 720);
+	native_update_monitor(&m);
+	assert(m.native_reserved == &first.c &&
+		   second.c.native_reason == NATIVE_REGION_OCCUPIED);
+	assert(second.c.native_status == NATIVE_REJECTED &&
+		   second.c.close_count == 0);
+	/* Away/return releases/reinstalls the column without closing the stream. */
+	m.seltags = 1;
+	native_update_monitor(&m);
+	assert(!m.native_reserved && !first.scene.node.enabled &&
+		   first.c.close_count == 0);
+	m.seltags = 0;
+	native_update_monitor(&m);
+	assert(m.native_reserved == &first.c &&
+		   first.c.native_status == NATIVE_ACCEPTED);
+	/* New valid hints configure a new exact size, not a scaled old buffer. */
+	first.top.current.min_width = 1280;
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_PENDING && first.c.close_count == 0);
+	assert(m.native_reserved == &first.c && first.c.native_geom.width == 1920);
+	first.top.current = (struct wlr_xdg_toplevel_state){1280, 720, 1280, 720};
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_PENDING &&
+		   !first.scene.node.enabled);
+	ack(&first);
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_ACCEPTED && first.c.geom.x == 2118);
+	/* Group bars are optional in 0.18; no native decoration may be exposed. */
+	first.c.dim_node = &first.group;
+	first.c.group_bar = NULL;
+	first.decor.node.enabled = true;
+	native_present(&first.c);
+	assert(first.scene.node.enabled && !first.decor.node.enabled);
+	first.c.group_bar = &first.group;
+	/* Even after acceptance, a wrong buffer is not shown. */
+	first.c.wl_surface.current.buffer_width--;
+	native_present(&first.c);
+	assert(!first.scene.node.enabled);
+	ack(&first);
+	native_update_monitor(&m);
+	assert(first.scene.node.enabled);
+	/* Revocation preserves JSON state and requests close exactly once. */
+	output.scale = 1.25;
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_REJECTED &&
+		   first.c.native_reason == NATIVE_UNSUPPORTED_SCALE);
+	assert(!m.native_reserved && first.c.close_count == 1 &&
+		   !first.scene.node.enabled);
+	native_update_monitor(&m);
+	assert(first.c.close_count == 1);
+	output.scale = 1;
+	init(&zero, &m, 3, 0, 0);
+	native_update_monitor(&m);
+	assert(zero.c.native_status == NATIVE_PENDING && !m.native_reserved);
+	zero.top.current = (struct wlr_xdg_toplevel_state){1920, 1080, 1920, 1080};
+	native_update_monitor(&m);
+	ack(&zero);
+	native_update_monitor(&m);
+	assert(zero.c.native_status == NATIVE_ACCEPTED);
+	output.enabled = false;
+	native_update_monitor(&m);
+	assert(zero.c.native_reason == NATIVE_OUTPUT_UNAVAILABLE &&
+		   zero.c.close_count == 1);
+	assert(strcmp(native_status_names[zero.c.native_status], "rejected") == 0);
+	assert(strcmp(native_reason_names[zero.c.native_reason],
+				  "output_unavailable") == 0);
+	/* A correctly sized initial neutral buffer must not need another commit. */
+	wl_list_init(&server.clients);
+	output.enabled = true;
+	m.native_reserved = NULL;
+	init(&zero, &m, 4, 1920, 1080);
+	zero.c.native_width = 1920;
+	zero.c.native_height = 1080;
+	ack(&zero);
+	zero.xdg.current.configure_serial = 50;
+	uint32_t before = next_serial;
+	native_update_monitor(&m);
+	assert(zero.c.native_status == NATIVE_ACCEPTED && next_serial == before);
+	/* Unmap releases the reservation, so another stream can be admitted. */
+	zero.c.wl_surface.mapped = false;
+	native_update_monitor(&m);
+	assert(!m.native_reserved && zero.c.close_count == 0);
+	init(&first, &m, 5, 2758, 1440);
+	native_update_monitor(&m);
+	ack(&first);
+	native_update_monitor(&m);
+	assert(first.c.native_status == NATIVE_ACCEPTED);
+	m.w.width--;
+	native_update_monitor(&m);
+	assert(first.c.native_reason == NATIVE_TOO_LARGE &&
+		   first.c.close_count == 1);
+	test_overview_and_sleep();
+	puts("native reservation: all checks passed");
+}
