+struct wlr_box native_workarea(Monitor *m) {
+	struct wlr_box area = m->w;
+	if (m->native_reserved)
+		area.width -= m->native_reserved->native_geom.width;
+	return area;
+}
+
+const Layout *native_layout(const Monitor *m) {
+	return m->native_reserved ? &layouts[1]
+							  : m->pertag->ltidxs[get_mon_curtag(m)];
+}
+
+bool native_target_locked(const Arg *arg) {
+	Client *c =
+		arg->tc
+			? arg->tc
+			: (server.selected_monitor ? server.selected_monitor->sel : NULL);
+	return c && c->reserve_right;
+}
+
+#include "native_stream.h"
diff --git a/src/layout/native_geometry.h b/src/layout/native_geometry.h
new file mode 100644
index 00000000..320df240
--- /dev/null
+++ b/src/layout/native_geometry.h
@@ -0,0 +1,59 @@
+#ifndef MANGO_NATIVE_GEOMETRY_H
+#define MANGO_NATIVE_GEOMETRY_H
+
+#include <limits.h>
+#include <math.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <wlr/util/box.h>
+
+enum native_status { NATIVE_PENDING, NATIVE_ACCEPTED, NATIVE_REJECTED };
+enum native_reason {
+	NATIVE_OK,
+	NATIVE_TOO_LARGE,
+	NATIVE_OUTPUT_UNAVAILABLE,
+	NATIVE_UNSUPPORTED_SCALE,
+	NATIVE_REGION_OCCUPIED,
+	NATIVE_INVALID_SIZE
+};
+
+static const char *const native_status_names[] = {"pending", "accepted",
+												  "rejected"};
+static const char *const native_reason_names[] = {NULL,
+												  "too_large",
+												  "output_unavailable",
+												  "unsupported_scale",
+												  "region_occupied",
+												  "invalid_size"};
+
+/* All arithmetic is checked before constructing layout-relative rectangles. */
+static inline enum native_reason
+native_geometry(struct wlr_box usable, float scale, bool output_available,
+				bool occupied, int32_t min_width, int32_t min_height,
+				int32_t max_width, int32_t max_height, struct wlr_box *stream,
+				struct wlr_box *local) {
+	if (!output_available || usable.width <= 0 || usable.height <= 0)
+		return NATIVE_OUTPUT_UNAVAILABLE;
+	if (!isfinite(scale) || scale != 1.0f)
+		return NATIVE_UNSUPPORTED_SCALE;
+	if (min_width <= 0 || min_height <= 0 || min_width != max_width ||
+		min_height != max_height)
+		return NATIVE_INVALID_SIZE;
+	if (usable.width < 640 || min_width > usable.width - 640 ||
+		min_height > usable.height)
+		return NATIVE_TOO_LARGE;
+	if ((int64_t)usable.x + usable.width > INT_MAX ||
+		(int64_t)usable.y + usable.height > INT_MAX)
+		return NATIVE_INVALID_SIZE;
+	if (occupied)
+		return NATIVE_REGION_OCCUPIED;
+	*local = usable;
+	local->width -= min_width;
+	*stream = (struct wlr_box){usable.x + local->width,
+							   usable.y + (usable.height - min_height) / 2,
+							   min_width, min_height};
+	return NATIVE_OK;
+}
+
+#endif
diff --git a/src/layout/native_stream.h b/src/layout/native_stream.h
new file mode 100644
index 00000000..3ca2074d
--- /dev/null
+++ b/src/layout/native_stream.h
@@ -0,0 +1,204 @@
+/* A reservation is derived from mapped clients, never from the saved tag
+ * layout. */
+static bool native_visible(Client *c, Monitor *m) {
+	return c->mon == m && !c->iskilling && !m->isoverview && !m->only_sleep &&
+		   m->wlr_output->enabled && client_surface(c)->mapped &&
+		   (c->tags & m->tagset[m->seltags]);
+}
+
+static bool native_matches_buffer(Client *c) {
+	if (client_is_x11(c))
+		return false;
+	struct wlr_surface_state *s = &client_surface(c)->current;
+	struct wlr_box *g = &c->surface.xdg->geometry;
+	return g->x == 0 && g->y == 0 && g->width == c->native_width &&
+		   g->height == c->native_height && s->width == c->native_width &&
+		   s->height == c->native_height &&
+		   s->buffer_width == c->native_width &&
+		   s->buffer_height == c->native_height && s->scale == 1 &&
+		   s->transform == WL_OUTPUT_TRANSFORM_NORMAL;
+}
+
+void native_present(Client *c) {
+	if (!c->scene)
+		return;
+	if (c->native_status == NATIVE_ACCEPTED && !native_matches_buffer(c))
+		c->native_status = NATIVE_PENDING;
+	bool show = c->native_status == NATIVE_ACCEPTED && c->mon &&
+				c->mon->native_reserved == c && native_visible(c, c->mon) &&
+				native_matches_buffer(c);
+	c->animation.running = c->animation.tagining = c->animation.tagouting =
+		false;
+	c->animation.tagouted = c->is_pending_open_animation = false;
+	c->need_output_flush = false;
+	wlr_scene_node_set_enabled(&c->scene->node, show);
+	if (!show)
+		return;
+	c->geom = c->current = c->pending = c->animation.current = c->native_geom;
+	wlr_scene_node_set_position(&c->scene->node, c->geom.x, c->geom.y);
+	wlr_scene_node_set_position(&c->scene_surface->node, 0, 0);
+	wlr_scene_node_set_enabled(&c->scene_surface->node, true);
+	/* No compositor scaling, clipping, effects, borders, or transition
+	 * snapshots. */
+	wlr_scene_subsurface_tree_set_clip(&c->scene_surface->node, NULL);
+	wlr_scene_node_set_enabled(&c->border->node, false);
+	wlr_scene_node_set_enabled(&c->shadow->node, false);
+	wlr_scene_node_set_enabled(&c->blur->node, false);
+	wlr_scene_node_set_enabled(&c->shield->node, false);
+	if (c->group_bar) {
+		wlr_scene_node_set_enabled(&c->group_bar->scene->node, false);
+		wlr_scene_node_set_enabled(&c->group_bar->scene_buffer->node, false);
+	}
+	if (c->dim_node)
+		wlr_scene_node_set_enabled(&c->dim_node->scene_buffer->node, false);
+}
+
+void native_reject(Client *c, enum native_reason reason) {
+	c->native_status = NATIVE_REJECTED;
+	c->native_reason = reason;
+	if (c->mon && c->mon->sel == c) {
+		c->mon->sel = NULL;
+		if (client_surface(c) == server.seat->keyboard_state.focused_surface)
+			wlr_seat_keyboard_clear_focus(server.seat);
+	}
+	if (c->mon && c->mon->native_reserved == c)
+		c->mon->native_reserved = NULL;
+	native_present(c);
+	if (c->native_ever_accepted && !c->native_close_sent) {
+		c->native_close_sent = true;
+		client_send_close(c);
+	}
+}
+
+static enum native_reason native_validate(Client *c, Monitor *m,
+										  struct wlr_box *geom) {
+	struct wlr_box local;
+	c->native_usable = m->w;
+	c->native_scale = m->wlr_output->scale;
+	if (client_is_x11(c))
+		return NATIVE_INVALID_SIZE;
+	struct wlr_xdg_toplevel_state *s = &c->surface.xdg->toplevel->current;
+	c->native_width = s->min_width;
+	c->native_height = s->min_height;
+	return native_geometry(
+		m->w, c->native_scale,
+		m->wlr_output->enabled && !strcmp(m->wlr_output->name, "DP-2"), false,
+		s->min_width, s->min_height, s->max_width, s->max_height, geom, &local);
+}
+
+void native_update_monitor(Monitor *m) {
+	Client *c, *owner = NULL, *previous = m->native_reserved;
+	m->native_reserved = NULL;
+	wl_list_for_each(c, &server.clients, link) {
+		if (!c->reserve_right || c->mon != m || c->iskilling)
+			continue;
+		c->native_usable = m->w;
+		c->native_scale = m->wlr_output->scale;
+		if (c->native_status == NATIVE_REJECTED) {
+			native_present(c);
+			continue;
+		}
+		if (m->only_sleep || (m->isoverview && m->wlr_output->enabled)) {
+			c->native_status = NATIVE_PENDING;
+			c->native_reason = NATIVE_OK;
+			/* Sleep retains ownership; overview temporarily releases the
+			 * column. */
+			if (m->only_sleep && c == previous && client_surface(c)->mapped &&
+				(c->tags & m->tagset[m->seltags]))
+				owner = c;
+			native_present(c);
+			continue;
+		}
+		struct wlr_box geom;
+		enum native_reason reason = native_validate(c, m, &geom);
+		c->native_hints_pending = false;
+		if (reason == NATIVE_INVALID_SIZE && c->native_ever_accepted &&
+			!client_is_x11(c)) {
+			struct wlr_xdg_toplevel_state *s =
+				&c->surface.xdg->toplevel->current;
+			if (s->min_width <= 0 || s->min_height <= 0 ||
+				s->min_width != s->max_width ||
+				s->min_height != s->max_height) {
+				struct wlr_box old_geom, local;
+				enum native_reason old_reason = native_geometry(
+					m->w, c->native_scale, true, false, c->native_geom.width,
+					c->native_geom.height, c->native_geom.width,
+					c->native_geom.height, &old_geom, &local);
+				if (old_reason != NATIVE_OK) {
+					native_reject(c, old_reason);
+					continue;
+				}
+				/* SDL can commit the two hint setters separately while
+				 * resizing. */
+				c->native_status = NATIVE_PENDING;
+				c->native_hints_pending = true;
+				if (c == previous && native_visible(c, m))
+					owner = c;
+				native_present(c);
+				continue;
+			}
+		}
+		if (reason == NATIVE_INVALID_SIZE && !client_is_x11(c) &&
+			!c->native_ever_accepted) {
+			struct wlr_xdg_toplevel_state *s =
+				&c->surface.xdg->toplevel->current;
+			if (!s->min_width && !s->min_height && !s->max_width &&
+				!s->max_height) {
+				c->native_status = NATIVE_PENDING;
+				native_present(c);
+				continue;
+			}
+		}
+		if (reason != NATIVE_OK) {
+			native_reject(c, reason);
+			continue;
+		}
+		if (!native_visible(c, m)) {
+			c->native_status = NATIVE_PENDING;
+			native_present(c);
+			continue;
+		}
+		c->native_geom = geom;
+		/* Keep an existing reservation; otherwise the oldest mapped client
+		 * wins. */
+		if (!owner || c == previous || (owner != previous && c->id < owner->id))
+			owner = c;
+	}
+	m->native_reserved = owner;
+	wl_list_for_each(c, &server.clients, link) {
+		if (!c->reserve_right || c->mon != m || c->iskilling ||
+			c->native_status == NATIVE_REJECTED || !native_visible(c, m) ||
+			c->native_width <= 0 || c->native_height <= 0)
+			continue;
+		if (c != owner) {
+			native_reject(c, NATIVE_REGION_OCCUPIED);
+			continue;
+		}
+		if (c->native_hints_pending)
+			continue;
+		if (!wlr_box_equal(&c->geom, &c->native_geom) || !c->native_serial) {
+			c->geom = c->native_geom;
+			/* A neutral buffer already at the requested size needs no resize.
+			 * Forcing another configure here deadlocks clients awaiting
+			 * admission before their next presentation (SDL does not redraw
+			 * unchanged sizes). */
+			c->native_serial = native_matches_buffer(c)
+								   ? c->surface.xdg->current.configure_serial
+								   : wlr_xdg_toplevel_set_size(
+										 c->surface.xdg->toplevel,
+										 c->native_width, c->native_height);
+		}
+		bool acknowledged = (int32_t)(c->surface.xdg->current.configure_serial -
+									  c->native_serial) >= 0;
+		c->native_status = acknowledged && native_matches_buffer(c)
+							   ? NATIVE_ACCEPTED
+							   : NATIVE_PENDING;
+		c->native_reason = NATIVE_OK;
+		bool first_accept =
+			!c->native_ever_accepted && c->native_status == NATIVE_ACCEPTED;
+		c->native_ever_accepted |= c->native_status == NATIVE_ACCEPTED;
+		native_present(c);
+		if (first_accept)
+			client_focus(c, 1);
+	}
+}
