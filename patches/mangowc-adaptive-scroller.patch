diff --git a/src/layout/horizontal.h b/src/layout/horizontal.h
--- a/src/layout/horizontal.h
+++ b/src/layout/horizontal.h
@@ -247,0 +248,22 @@
+	if ((float)n * scroller_default_proportion <= 1.0f) {
+		unsigned int available_width =
+			m->w.width - 2 * cur_gappoh - (n - 1) * cur_gappih;
+		unsigned int equal_client_width = available_width / n;
+		int visible_right = m->w.x + m->w.width - cur_gappoh;
+
+		target_geom.height = m->w.height - 2 * cur_gappov;
+		target_geom.x = m->w.x + cur_gappoh;
+		target_geom.y = m->w.y + cur_gappov;
+
+		for (i = 0; i < n; i++) {
+			c = tempClients[i];
+			target_geom.width =
+				i == n - 1 ? visible_right - target_geom.x : equal_client_width;
+			resize(c, target_geom, 0);
+			target_geom.x += target_geom.width + cur_gappih;
+		}
+
+		free(tempClients);
+		return;
+	}
+
@@ -296,6 +318,9 @@
-			target_geom.x = root_client->geom.x > m->w.x + (m->w.width) / 2
-								? m->w.x + (m->w.width -
-											root_client->scroller_proportion *
-												max_client_width -
-											scroller_structs)
-								: m->w.x + scroller_structs;
+			int visible_left = m->w.x + scroller_structs;
+			int visible_right = m->w.x + m->w.width - scroller_structs;
+
+			target_geom.x = root_client->geom.x;
+			if (target_geom.x < visible_left) {
+				target_geom.x = visible_left;
+			} else if (target_geom.x + target_geom.width > visible_right) {
+				target_geom.x = visible_right - target_geom.width;
+			}
