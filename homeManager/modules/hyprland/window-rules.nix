''
  -- Window rules
  hl.window_rule({ name = "spotify-workspace", match = { class = "spotify" }, workspace = "10 silent" })
  hl.window_rule({ name = "discord-workspace", match = { class = "vesktop" }, workspace = "9 silent" })
  hl.window_rule({ name = "herdr-workspace", match = { class = "com.yvesd.herdr" }, workspace = "3 silent" })
  hl.window_rule({ name = "floating-border", match = { float = true }, border_size = 2 })
  hl.window_rule({ name = "floating-opacity", match = { float = true }, opacity = "0.8" })
''
